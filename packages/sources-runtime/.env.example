# Source collector runtime (docs/sources-setup.md). Donor variables from src/env.ts apply unchanged.
DATABASE_URL=
ENCRYPTION_KEY=
API_KEY_PEPPER=
PORT=3100
# Public https origin of this runtime (OAuth launch/callback, webhooks, device ingest host)
SOURCES_RUNTIME_PUBLIC_URL=
WEBHOOK_BASE_URL=
# sha256 hex of yc_msaw's SOURCES_RUNTIME_SERVICE_TOKEN; optional separate internal listener
SOURCES_RUNTIME_SERVICE_TOKEN_SHA256=
SOURCES_RUNTIME_INTERNAL_PORT=
SOURCES_RUNTIME_INTERNAL_HOST=127.0.0.1
# S3 for donor binary documents
AWS_REGION=

# Google: direct OAuth web client (redirect: ${SOURCES_RUNTIME_PUBLIC_URL}/auth/google/oauth/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Google: domain-wide delegation service account + operator allowlist {"<tenantNs>":{"domains":[...]}}
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_DWD_TENANT_APPROVALS=
# Google via Composio (optional)
COMPOSIO_API_KEY=
COMPOSIO_GOOGLE_AUTH_CONFIG_ID=

# Nango (secret key for the API; the webhook signing key is a separate value)
NANGO_SECRET_KEY=
# Donor /webhooks/nango route: the webhook SIGNING key (X-Nango-Hmac-Sha256 only)
NANGO_WEBHOOK_SECRET=
# Generic records lane /webhooks/nango-records (+ previous key during rotation) and its operator catalog
NANGO_WEBHOOK_SIGNING_KEY=
NANGO_WEBHOOK_SIGNING_KEY_PREVIOUS=
NANGO_RECORDS_CONFIG=
# Stripe needs no runtime env: keys are connected per tenant (POST /v1/sources/connect/stripe)

# Experimental personal WhatsApp/Instagram via Unipile (ToS risk; read-only). Off unless set to 1.
UNIPILE_PERSONAL_CONNECTORS_ENABLED=

# Zoom user-managed General OAuth app (redirect: ${SOURCES_RUNTIME_PUBLIC_URL}/auth/zoom/callback)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
