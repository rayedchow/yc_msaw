{
  "name": "@procmem/sdk",
  "version": "0.1.0",
  "description": "Procedural-memory SDK: full agent trace capture, plus live exposure of every tenant MCP tool (memory + deployed integration MCPs) to any harness, Pi, or MCP client via a stdio bridge.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/sdk/client.js",
  "types": "./dist/sdk/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/client.d.ts",
      "import": "./dist/sdk/client.js"
    },
    "./pi": {
      "types": "./dist/sdk/pi-adapter.d.ts",
      "import": "./dist/sdk/pi-adapter.js"
    },
    "./live": {
      "types": "./dist/sdk/live/index.d.ts",
      "import": "./dist/sdk/live/index.js"
    },
    "./live/pi": {
      "types": "./dist/sdk/live/pi.d.ts",
      "import": "./dist/sdk/live/pi.js"
    },
    "./oauth": {
      "types": "./dist/sdk/oauth-refresh.d.ts",
      "import": "./dist/sdk/oauth-refresh.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "~2.3.1",
    "@modelcontextprotocol/server": "~2.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "bin": {
    "procmem-live-mcp": "./dist/sdk/live/bridge-cli.js"
  }
}
