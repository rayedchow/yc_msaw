# --- Server -------------------------------------------------------------
PORT=3000
# Loopback by default. Any non-loopback bind or public URL requires auth,
# PROCMEM_STORE=modal and PROCMEM_SANDBOX=modal (startup fails closed otherwise).
HOST=127.0.0.1
# Canonical public MCP URL (OAuth resource identity), e.g. https://<slug>.run.mcp-use.com/mcp
MCP_PUBLIC_URL=

# --- Storage / isolation --------------------------------------------------
# directory = local only (dev/tests); modal = Modal Volume authority (survives redeploys)
PROCMEM_STORE=directory
# modal = customer shell + build workspaces in Modal sandboxes (default);
# local = trusted offline fixtures only (cannot execute commands)
PROCMEM_SANDBOX=modal
PROCMEM_DATA_DIR=.data
# Modal credentials for hosted deployments (local dev uses ~/.modal.toml)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Daily build models (host-side only; never sent to sandboxes) ----------
FIREWORKS_API_KEY=
PROCMEM_BUILD_MODEL=accounts/fireworks/models/kimi-k3
PROCMEM_CHILD_MODELS=accounts/fireworks/models/glm-5p3,accounts/fireworks/models/minimax-m3
# Day partition offset from UTC in minutes (0 = UTC days)
PROCMEM_DAY_OFFSET_MINUTES=0

# --- Integration research (host-side only) ----------------------------------
EXA_API_KEY=

# --- Auth (see docs/auth.md) -----------------------------------------------
# workos | oidc | static | none (inferred when unset)
AUTH_MODE=
WORKOS_AUTHKIT_DOMAIN=sincere-umbrella-45-staging.authkit.app
WORKOS_CLIENT_ID=
# Okta / generic OIDC
OIDC_ISSUER=
OIDC_AUDIENCE=
# Admin privileges for OAuth users (memory:build, traces:write)
PROCMEM_ADMIN_SUBJECTS=
# Static scoped keys for the SDK / CI: sha256hex:tenant:scope1+scope2 (generate: npx tsx src/auth/keygen.ts)
PROCMEM_STATIC_KEYS=
PROCMEM_STATIC_KEYS_ON_MCP=

# --- Sources filesystem (see docs/sources-setup.md) --------------------------
# 0 disables $SOURCES tools and /v1/sources routes (on by default)
PROCMEM_SOURCES=
# Internal URL of packages/sources-runtime and the server-held service secret (>= 32 chars);
# the runtime keeps only SOURCES_RUNTIME_SERVICE_TOKEN_SHA256. Unset = no runtime-control routes.
SOURCES_RUNTIME_URL=
SOURCES_RUNTIME_SERVICE_TOKEN=
# Public https origin the runtime publishes to (default: origin of MCP_PUBLIC_URL)
SOURCES_PUBLISH_URL=
# Runtime public device host handed to the Mac iMessage uploader (unset = device setup answers 503)
SOURCES_DEVICE_API_URL=
