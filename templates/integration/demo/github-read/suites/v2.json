   },
   {
    "name": "heldout: nested path at a tag",
    "fixture": {
     "name": "github-contents",
     "config": {}
    },
    "env": {
     "GITHUB_API_BASE_URL": "{{fixture.url}}"
    },
    "steps": [
     {
      "tool": "read_file",
      "arguments": {
       "owner": "fixture-org",
       "repo": "modern",
       "path": "docs/guide.md",
       "ref": "v2.0.0"
      },
      "expect": [
       {
        "path": "structuredContent.text",
        "op": "contains",
        "value": "Guide at v2.0.0"
       }
      ]
     }
    ]
   }
  ]
 }
]
