{
 "slug": "crm-attio",
 "title": "Attio",
 "description": "Attio records integration (HOST-SEEDED DEFICIENT revision for the far-repair demo; ported from HubSpot adapter conventions).",
 "version": "0.1.0",
 "upstream": {
  "name": "Attio REST API v2 — synthetic contract fixture",
  "docs": [
   "https://api.attio.com/openapi/api"
  ]
 },
 "tools": [
  "integration_info",
  "search_records",
  "get_record",
  "update_record"
 ],
 "env": [
  {
   "name": "ATTIO_BASE_URL",
   "required": true,
   "secret": false,
   "description": "Attio API base URL"
  },
  {
   "name": "ATTIO_TOKEN",
   "required": true,
   "secret": true,
   "description": "Attio credential (injected by the host)"
  },
  {
   "name": "ATTIO_INSTANCE_LABEL",
   "required": false,
   "secret": false,
   "description": "Human label of the connected instance"
  }
 ],
 "smoke": [
  {
   "name": "integration_info responds",
   "steps": [
    {
     "tool": "integration_info",
     "arguments": {},
     "expect": [
      {
       "path": "structuredContent.slug",
       "op": "equals",
       "value": "crm-attio"
      }
     ]
    }
   ]
  },
  {
   "name": "fixture: get_record of unknown id returns a structured error",
   "fixture": {
    "name": "crm-fixture",
    "config": {
     "vendor": "attio",
     "seed": "smoke-attio",
     "spec": {
      "instanceLabel": "Smoke Org",
      "target": {
       "name": "Smoke Target Co",
       "domain": "smoke-target.example"
      },
      "duplicateDomain": "smoke-target-holdings.example",
      "fillerNames": [
       "Filler One",
       "Filler Two",
       "Filler Three"
      ],
      "family": "exec-review"
     }
    }
   },
   "env": {
    "ATTIO_BASE_URL": "{{fixture.url}}",
    "ATTIO_TOKEN": "{{fixture.token}}"
   },
   "steps": [
    {
     "tool": "get_record",
     "arguments": {
      "object": "deals",
      "record_id": "00000000-0000-4000-8000-000000000000"
     },
     "expect": [
      {
       "path": "structuredContent.http_status",
       "op": "equals",
       "value": 404
      }
     ]
    }
   ]
  }
 ]
}
