{
 "slug": "crm-attio",
 "title": "Attio",
 "description": "Attio raw REST contract tool for this organization's Attio instance (synthetic contract fixture upstream in this benchmark).",
 "version": "1.0.0",
 "upstream": {
  "name": "Attio REST API v2 — synthetic contract fixture",
  "docs": [
   "https://api.attio.com/openapi/api",
   "https://docs.attio.com/rest-api/guides/filtering-and-sorting"
  ]
 },
 "tools": [
  "integration_info",
  "attio_request"
 ],
 "env": [
  {
   "name": "ATTIO_BASE_URL",
   "required": true,
   "secret": false,
   "description": "Attio API base URL"
  },
  {
   "name": "ATTIO_TOKEN",
   "required": true,
   "secret": true,
   "description": "Attio credential (injected by the host)"
  },
  {
   "name": "ATTIO_INSTANCE_LABEL",
   "required": false,
   "secret": false,
   "description": "Human label of the connected instance"
  }
 ],
 "smoke": [
  {
   "name": "integration_info responds",
   "steps": [
    {
     "tool": "integration_info",
     "arguments": {},
     "expect": [
      {
       "path": "structuredContent.slug",
       "op": "equals",
       "value": "crm-attio"
      }
     ]
    }
   ]
  },
  {
   "name": "fixture: attio metadata read",
   "fixture": {
    "name": "crm-fixture",
    "config": {
     "vendor": "attio",
     "seed": "smoke-attio",
     "spec": {
      "instanceLabel": "Smoke Org",
      "target": {
       "name": "Smoke Target Co",
       "domain": "smoke-target.example"
      },
      "duplicateDomain": "smoke-target-holdings.example",
      "fillerNames": [
       "Filler One",
       "Filler Two",
       "Filler Three"
      ],
      "family": "exec-review"
     }
    }
   },
   "env": {
    "ATTIO_BASE_URL": "{{fixture.url}}",
    "ATTIO_TOKEN": "{{fixture.token}}"
   },
   "steps": [
    {
     "tool": "attio_request",
     "arguments": {
      "method": "GET",
      "path": "/v2/objects"
     },
     "expect": [
      {
       "path": "structuredContent.http_status",
       "op": "equals",
       "value": 200
      }
     ]
    }
   ]
  }
 ]
}
