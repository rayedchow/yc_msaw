   "secret": false,
   "description": "HubSpot CRM API base URL"
  },
  {
   "name": "HUBSPOT_TOKEN",
   "required": true,
   "secret": true,
   "description": "HubSpot CRM credential (injected by the host)"
  },
  {
   "name": "HUBSPOT_INSTANCE_LABEL",
   "required": false,
   "secret": false,
   "description": "Human label of the connected instance"
  }
 ],
 "smoke": [
  {
   "name": "integration_info responds",
   "steps": [
    {
     "tool": "integration_info",
     "arguments": {},
     "expect": [
      {
       "path": "structuredContent.slug",
       "op": "equals",
       "value": "crm-hubspot"
      }
     ]
    }
   ]
  },
  {
   "name": "fixture: hubspot metadata read",
   "fixture": {
    "name": "crm-fixture",
    "config": {
     "vendor": "hubspot",
     "seed": "smoke-hubspot",
     "spec": {
      "instanceLabel": "Smoke Org",
      "target": {
       "name": "Smoke Target Co",
       "domain": "smoke-target.example"
      },
      "duplicateDomain": "smoke-target-holdings.example",
