     }
    }
   },
   "env": {
    "HUBSPOT_BASE_URL": "{{fixture.url}}",
    "HUBSPOT_TOKEN": "{{fixture.token}}"
   },
   "steps": [
    {
     "tool": "hubspot_request",
     "arguments": {
      "method": "GET",
      "path": "/crm/v3/pipelines/deals"
     },
     "expect": [
      {
       "path": "structuredContent.http_status",
