{
 "slug": "crm-hubspot",
 "title": "HubSpot CRM",
 "description": "HubSpot CRM raw REST contract tool for this organization's HubSpot CRM instance (synthetic contract fixture upstream in this benchmark).",
 "version": "1.0.0",
 "upstream": {
  "name": "HubSpot CRM API (v3 objects/search/properties/pipelines, v4 associations) — synthetic contract fixture",
  "docs": [
